BOT_TOKEN=

# Германская панель
GERMAN_PANEL_HOME_URL=
# API-токен панели (3x-ui → Settings → Security/API). Authorization: Bearer
XUI_API_TOKEN_GERM=
# База для ссылки подписки (напр. https://bimbambom.site:2096/sub/)
GERM_SUB_BASE_URL=
# ID inbound'ов (по умолчанию WS=3, XHTTP=2)
# GERM_WS_INBOUND=3
# GERM_XHTTP_INBOUND=2
# Reality inbound, привязывается ко всем клиентам и попадает в подписку (по умолчанию 5; 0 = выключить)
# GERM_REALITY_INBOUND=5

# Латвийская панель
LATV_PANEL_HOME_URL=
# API-токен панели (3x-ui → Settings → Security/API). Authorization: Bearer
XUI_API_TOKEN_LATV=
# База для ссылки подписки (по умолчанию https://petromerzlikino.site:2096/sub/)
# LATV_SUB_BASE_URL=
# ID inbound'ов на Latvian панели (по умолчанию WS prod=1/dev=3).
# LATV_WS_INBOUND_PROD=1
# LATV_WS_INBOUND_DEV=3
# XHTTP на Риге больше нет — LATV_XHTTP_INBOUND_* не используются.
# Reality inbound, привязывается ко всем клиентам и попадает в подписку (prod по умолчанию 8; 0 = выключить; в dev по умолчанию выключен)
# LATV_REALITY_INBOUND_PROD=8
# LATV_REALITY_INBOUND_DEV=

# Примечание: vless/xhttp-ссылки теперь генерирует сама панель
# (GET /panel/api/clients/links/{email}), поэтому ручные xHTTP-параметры
# (порты, host, pbk/sni/sid/fp/path/spx) больше не нужны.

DB_LINK_PROD=
DB_LINK_DEV=

DB_USER=
DB_PASSWORD=
DB_NAME=

ADMIN_CHATS=
